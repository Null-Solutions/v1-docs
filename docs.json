      "source": "/",
      "destination": "/private-beta/about-null/overview"
    },
    {
      "source": "/private-beta/overview",
      "destination": "/private-beta/about-null/overview"
    },
    {
      "source": "/private-beta/getting-started",
      "destination": "/private-beta/getting-started/null-private-beta"
    },
    {
      "source": "/private-beta/fund-account",
      "destination": "/private-beta/getting-started/fund-your-account"
    },
    {
      "source": "/private-beta/trading",
      "destination": "/private-beta/trading/placing-a-position"
    },
    {
      "source": "/private-beta/portfolio",
      "destination": "/private-beta/portfolios/portfolio-overview"
    },
    {
      "source": "/private-beta/strategies",
