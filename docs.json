{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Null V1",
  "theme": "luma",
  "colors": {
    "primary": "#2d2c2c",
    "light": "#2d2c2c",
    "dark": "#d4dce7"
  },
  "logo": {
    "light": "/images/Logo.svg",
    "dark": "/images/LogoDark.svg"
  },
  "favicon": "/images/LogoIcon.svg",
  "appearance": {
    "default": "system"
