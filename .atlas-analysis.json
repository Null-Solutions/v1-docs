  "keyFeatures": [
    "Pooled directional perpetuals with no liquidations",
    "ERC-4626 tokenized receiver and payer pool shares",
    "Pluggable oracle support: Pyth, Chainlink Data Streams, Uniswap V3 TWAP, block base fee",
    "Yield-bearing collateral support (e.g. waUSDC) with optional yield fee",
    "Configurable funding multiplier (mu) per market",
    "Price circuit breaker limiting max settlement per time window",
    "NullV1Router for combined create/deposit/redeem with slippage protection",
    "NullV1Lens for read-only state previews and simulations",
    "Unique markets per (asset, oracle, mu) tuple via factory clone pattern",
    "On-chain fee collection with entry, exit, and yield fee configuration"
  ],
  "publicApiSurface": [
    "INullV1Factory.createMarket(asset, oracle, mu)",
    "INullV1Factory.getMarket(asset, oracle, mu)",
    "INullV1Market.state()",
    "INullV1Market.collectFees()",
    "INullV1Market.entryFee() / exitFee() / yieldFee()",
    "INullV1Pool (ERC-4626): deposit, withdraw, redeem, mint",
    "INullV1Pool.poolKind() → Receiver | Payer",
    "INullV1Oracle.price() → uint256 (1e36 scaled)",
    "INullV1Oracle.displayName() / baseName() / baseSymbol() / quoteName() / quoteSymbol()",
    "INullV1UpdatableOracle.update(updateData) / getUpdateFee(updateData)",
    "NullV1Router.createMarket(factory, asset, oracle, mu, updateData)",
    "NullV1Router.depositMarket(market, receiverAssets, payerAssets, minReceiverShares, minPayerShares, deadline, updateData)",
    "NullV1Router.redeemMarket(market, receiverShares, payerShares, minReceiverAssets, minPayerAssets, deadline, updateData)",
    "NullV1Lens.previewState(market)",
    "NullV1Lens.simulateState(market, externalPrice)",
    "NullV1Lens.previewMarket(market)",
    "NullV1Lens.simulateMarket(market, price)",
    "MarketCreated event: (asset, oracle, mu, market, receiverPool, payerPool)",
    "StateUpdated event: (timestamp, receiverPoolAssets, payerPoolAssets, price, protocolFees, sharePrice)"
  ]
}
