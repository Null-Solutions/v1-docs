---
title: Funding and carry
---
flowchart LR
  receiver["Receiver pool<br/><small>collateral yield<br/>minus funding paid</small>"]
  payer["Payer pool<br/><small>collateral yield<br/>plus funding received</small>"]
  funding["Funding rate<br/><small>set by pool imbalance</small>"]

  receiver -- "pays funding" --> payer
  funding -. "prices the payment" .-> receiver
  funding -. "prices the payment" .-> payer

  classDef receiver fill:#FFFFFF,color:#0B0E15,stroke:#45A5FF,stroke-width:2px;
  classDef payer fill:#FFFFFF,color:#0B0E15,stroke:#1B252D,stroke-width:2px;
  classDef accent fill:#B1DFFF,color:#0B0E15,stroke:#96AEC4,stroke-width:1px;
  class receiver receiver;
  class payer payer;
  class funding accent;
