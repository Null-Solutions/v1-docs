flowchart LR
  receiver(("Receiver"))
  payer(("Payer"))
  funding["Funding rate"]

  receiver -- "positive funding" --> payer
  payer -- "negative funding" --> receiver
  funding -. "sets signed Receiver leg" .-> receiver
  funding -. "sets signed Payer leg" .-> payer

  classDef receiver fill:#FFFFFF,color:#0B0E15,stroke:#45A5FF,stroke-width:2px;
  classDef payer fill:#FFFFFF,color:#0B0E15,stroke:#1B252D,stroke-width:2px;
  classDef accent fill:#B1DFFF,color:#0B0E15,stroke:#96AEC4,stroke-width:1px;
  class receiver receiver;
  class payer payer;
  class funding accent;
