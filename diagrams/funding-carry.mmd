flowchart LR
  exposure["Exposure ratio<br/><small>E = Receiver / Payer</small>"]
  curve["Funding curve<br/><small>Receiver APR = min(mu · E, cap)</small>"]
  receiver["Receiver carry<br/><small>collateral yield - funding</small>"]
  payer["Payer carry<br/><small>collateral yield + funding</small>"]
  yield["Collateral yield<br/><small>optional ERC-4626 collateral accounting</small>"]

  exposure --> curve
  curve -- funding cost --> receiver
  curve -- funding income --> payer
  yield -. separate from funding .-> receiver
  yield -. separate from funding .-> payer

